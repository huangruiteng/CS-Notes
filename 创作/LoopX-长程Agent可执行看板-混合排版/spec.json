          {"title": "Review", "text": "验证"},
          {"title": "Done", "text": "终态"}
        ]},
        {"type": "label", "text": "02 / WHAT THE SYSTEM KNOWS", "size": 28, "gap": 22},
        {"type": "cards", "columns": 2, "size": 33, "items": [
          {"title": "Identity & routing", "text": "goal_id / todo_id / owner / claimed_by"},
          {"title": "Authority & proof", "text": "scope / gate / evidence / receipt revision"}
