      "blocks": [
        {"type": "paragraph", "text": "Domain 决定业务事实和专业 transition，LoopX kernel 继续处理 claim、gate、monitor、quota、writeback 和 recovery。", "size": 45, "gap": 30},
        {"type": "cards", "columns": 1, "size": 35, "row_gap": 22, "items": [
